{
  "id": "open-awareness-5",
  "voiceId": "zh-cn-yunxi",
  "edgeVoice": "zh-CN-YunxiNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 130,
  "chunks": [
    {
      "index": 0,
      "text": "欢迎。",
      "file": "c000.ogg",
      "durationSec": 2.688
    },
    {
      "index": 1,
      "text": "找一个舒适的座位，或者如果感觉好一点的话就躺下来。",
      "file": "c001.ogg",
      "durationSec": 8.736
    },
    {
      "index": 2,
      "text": "让双手休息一下。",
      "file": "c002.ogg",
      "durationSec": 3.864
    },
    {
      "index": 3,
      "text": "软化眼睛，或闭上眼睛。",
      "file": "c003.ogg",
      "durationSec": 5.4
    },
    {
      "index": 4,
      "text": "缓慢吸气。",
      "file": "c004.ogg",
      "durationSec": 3.312
    },
    {
      "index": 5,
      "text": "并且呼气时间更长。",
      "file": "c005.ogg",
      "durationSec": 5.304
    },
    {
      "index": 6,
      "text": "从呼吸开始几个周期。",
      "file": "c006.ogg",
      "durationSec": 4.416
    },
    {
      "index": 7,
      "text": "[暂停：28]",
      "file": "c007.ogg",
      "durationSec": 4.536
    },
    {
      "index": 8,
      "text": "现在放宽。包括声音。",
      "file": "c008.ogg",
      "durationSec": 5.832
    },
    {
      "index": 9,
      "text": "靠近。远的。改变。稳定的。",
      "file": "c009.ogg",
      "durationSec": 9.216
    },
    {
      "index": 10,
      "text": "[暂停：28]",
      "file": "c010.ogg",
      "durationSec": 4.536
    },
    {
      "index": 11,
      "text": "包括身体的感觉。",
      "file": "c011.ogg",
      "durationSec": 3.816
    },
    {
      "index": 12,
      "text": "联络点。温度。脉搏柔和。",
      "file": "c012.ogg",
      "durationSec": 7.752
    },
    {
      "index": 13,
      "text": "[暂停：28]",
      "file": "c013.ogg",
      "durationSec": 4.536
    },
    {
      "index": 14,
      "text": "包括房间的空间。",
      "file": "c014.ogg",
      "durationSec": 3.84
    },
    {
      "index": 15,
      "text": "觉知如开阔的天空。",
      "file": "c015.ogg",
      "durationSec": 4.32
    },
    {
      "index": 16,
      "text": "[暂停：34]",
      "file": "c016.ogg",
      "durationSec": 4.512
    },
    {
      "index": 17,
      "text": "想法可能看起来像天气。",
      "file": "c017.ogg",
      "durationSec": 4.992
    },
    {
      "index": 18,
      "text": "无需追赶或推动他们。",
      "file": "c018.ogg",
      "durationSec": 4.56
    },
    {
      "index": 19,
      "text": "天空依然存在。",
      "file": "c019.ogg",
      "durationSec": 3.912
    },
    {
      "index": 20,
      "text": "[暂停：45]",
      "file": "c020.ogg",
      "durationSec": 4.56
    },
    {
      "index": 21,
      "text": "在这片空旷的田野里休息。",
      "file": "c021.ogg",
      "durationSec": 4.872
    },
    {
      "index": 22,
      "text": "[暂停：45]",
      "file": "c022.ogg",
      "durationSec": 4.56
    },
    {
      "index": 23,
      "text": "再轻松地吸一口气。",
      "file": "c023.ogg",
      "durationSec": 4.08
    },
    {
      "index": 24,
      "text": "动动手指。",
      "file": "c024.ogg",
      "durationSec": 3.264
    },
    {
      "index": 25,
      "text": "准备好后，睁开眼睛。",
      "file": "c025.ogg",
      "durationSec": 4.728
    },
    {
      "index": 26,
      "text": "随身携带一点这个。",
      "file": "c026.ogg",
      "durationSec": 4.008
    }
  ]
}
