{
  "id": "forgiveness-soft-10",
  "voiceId": "zh-cn-yunxi",
  "edgeVoice": "zh-CN-YunxiNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 179,
  "chunks": [
    {
      "index": 0,
      "text": "欢迎。",
      "file": "c000.ogg",
      "durationSec": 2.688
    },
    {
      "index": 1,
      "text": "需要时间到达。",
      "file": "c001.ogg",
      "durationSec": 3.72
    },
    {
      "index": 2,
      "text": "在支撑下坐下或躺下。",
      "file": "c002.ogg",
      "durationSec": 4.968
    },
    {
      "index": 3,
      "text": "如果感觉安全，请闭上眼睛。",
      "file": "c003.ogg",
      "durationSec": 5.904
    },
    {
      "index": 4,
      "text": "感受与地面的接触。",
      "file": "c004.ogg",
      "durationSec": 4.08
    },
    {
      "index": 5,
      "text": "缓慢吸气。",
      "file": "c005.ogg",
      "durationSec": 3.312
    },
    {
      "index": 6,
      "text": "呼气时间更长。",
      "file": "c006.ogg",
      "durationSec": 4.056
    },
    {
      "index": 7,
      "text": "[暂停：27]",
      "file": "c007.ogg",
      "durationSec": 4.608
    },
    {
      "index": 8,
      "text": "再次。",
      "file": "c008.ogg",
      "durationSec": 2.664
    },
    {
      "index": 9,
      "text": "[暂停：27]",
      "file": "c009.ogg",
      "durationSec": 4.608
    },
    {
      "index": 10,
      "text": "让肩膀下垂。",
      "file": "c010.ogg",
      "durationSec": 3.6
    },
    {
      "index": 11,
      "text": "让腹部变软。",
      "file": "c011.ogg",
      "durationSec": 3.504
    },
    {
      "index": 12,
      "text": "[暂停：34]",
      "file": "c012.ogg",
      "durationSec": 4.512
    },
    {
      "index": 13,
      "text": "这里的宽恕意味着松开自己紧握的拳头。",
      "file": "c013.ogg",
      "durationSec": 6.72
    },
    {
      "index": 14,
      "text": "不假装伤害并不重要。",
      "file": "c014.ogg",
      "durationSec": 5.112
    },
    {
      "index": 15,
      "text": "[暂停：34]",
      "file": "c015.ogg",
      "durationSec": 4.512
    },
    {
      "index": 16,
      "text": "从一些你反对自己的小事开始。",
      "file": "c016.ogg",
      "durationSec": 5.088
    },
    {
      "index": 17,
      "text": "一个错误。一个缺点。",
      "file": "c017.ogg",
      "durationSec": 5.616
    },
    {
      "index": 18,
      "text": "[暂停：34]",
      "file": "c018.ogg",
      "durationSec": 4.512
    },
    {
      "index": 19,
      "text": "默默地：我原谅自己是个人类。",
      "file": "c019.ogg",
      "durationSec": 5.952
    },
    {
      "index": 20,
      "text": "我释放我不再需要携带的东西。",
      "file": "c020.ogg",
      "durationSec": 5.4
    },
    {
      "index": 21,
      "text": "[暂停：54]",
      "file": "c021.ogg",
      "durationSec": 4.296
    },
    {
      "index": 22,
      "text": "如果感觉不错，请想象另一个人遇到的轻微困难。",
      "file": "c022.ogg",
      "durationSec": 8.472
    },
    {
      "index": 23,
      "text": "这不是最难的故事。更轻的。",
      "file": "c023.ogg",
      "durationSec": 6.528
    },
    {
      "index": 24,
      "text": "[暂停：34]",
      "file": "c024.ogg",
      "durationSec": 4.512
    },
    {
      "index": 25,
      "text": "我释放我能释放的。",
      "file": "c025.ogg",
      "durationSec": 3.888
    },
    {
      "index": 26,
      "text": "我保留我的界限。我放下了额外的重量。",
      "file": "c026.ogg",
      "durationSec": 7.128
    },
    {
      "index": 27,
      "text": "[暂停：54]",
      "file": "c027.ogg",
      "durationSec": 4.296
    },
    {
      "index": 28,
      "text": "呼吸到紧绷的地方。",
      "file": "c028.ogg",
      "durationSec": 4.08
    },
    {
      "index": 29,
      "text": "[暂停：68]",
      "file": "c029.ogg",
      "durationSec": 4.392
    },
    {
      "index": 30,
      "text": "在拳头软化时打开的空间中休息。",
      "file": "c030.ogg",
      "durationSec": 5.976
    },
    {
      "index": 31,
      "text": "[暂停：81]",
      "file": "c031.ogg",
      "durationSec": 4.344
    },
    {
      "index": 32,
      "text": "[暂停：41]",
      "file": "c032.ogg",
      "durationSec": 4.416
    },
    {
      "index": 33,
      "text": "开始加深呼吸。",
      "file": "c033.ogg",
      "durationSec": 3.792
    },
    {
      "index": 34,
      "text": "再次感受一下房间。",
      "file": "c034.ogg",
      "durationSec": 4.08
    },
    {
      "index": 35,
      "text": "摆动手指和脚趾。",
      "file": "c035.ogg",
      "durationSec": 4.32
    },
    {
      "index": 36,
      "text": "准备好后，睁开眼睛。",
      "file": "c036.ogg",
      "durationSec": 4.728
    },
    {
      "index": 37,
      "text": "慢慢地进入接下来的事情。",
      "file": "c037.ogg",
      "durationSec": 4.512
    }
  ]
}
