  "chunks": [
    {
      "index": 0,
      "text": "欢迎。",
      "file": "c000.ogg",
      "durationSec": 2.688
    },
    {
      "index": 1,
      "text": "这种练习使用温和的紧张和放松。",
      "file": "c001.ogg",
      "durationSec": 6.888
    },
    {
      "index": 2,
      "text": "如果可以的话请躺下，或者在有支撑的情况下坐下。",
      "file": "c002.ogg",
      "durationSec": 8.544
    },
    {
      "index": 3,
      "text": "如果感觉安全，请闭上眼睛。",
      "file": "c003.ogg",
      "durationSec": 5.904
    },
    {
      "index": 4,
      "text": "没什么好强求的。保持在舒适的范围内。",
      "file": "c004.ogg",
      "durationSec": 7.488
    },
    {
      "index": 5,
      "text": "缓慢吸气。",
      "file": "c005.ogg",
      "durationSec": 3.312
    },
    {
      "index": 6,
      "text": "并且呼气时间更长。",
      "file": "c006.ogg",
      "durationSec": 5.304
    },
    {
      "index": 7,
      "text": "[暂停：19]",
      "file": "c007.ogg",
      "durationSec": 4.272
    },
    {
      "index": 8,
      "text": "将注意力集中在双脚上。",
      "file": "c008.ogg",
      "durationSec": 5.064
    },
    {
      "index": 9,
      "text": "卷曲脚趾并收紧脚部。",
      "file": "c009.ogg",
      "durationSec": 5.16
    },
    {
      "index": 10,
      "text": "抓住。",
      "file": "c010.ogg",
      "durationSec": 2.616
    },
    {
      "index": 11,
      "text": "[暂停：19]",
      "file": "c011.ogg",
      "durationSec": 4.272
    },
    {
      "index": 12,
      "text": "发布。",
      "file": "c012.ogg",
      "durationSec": 2.592
    },
    {
      "index": 13,
      "text": "感受差异。",
      "file": "c013.ogg",
      "durationSec": 3.312
    },
    {
      "index": 14,
      "text": "[暂停：21]",
      "file": "c014.ogg",
      "durationSec": 4.488
    },
    {
      "index": 15,
      "text": "收紧小腿。",
      "file": "c015.ogg",
      "durationSec": 3.288
    },
    {
      "index": 16,
      "text": "抓住。",
      "file": "c016.ogg",
      "durationSec": 2.616
    },
    {
      "index": 17,
      "text": "[暂停：19]",
      "file": "c017.ogg",
