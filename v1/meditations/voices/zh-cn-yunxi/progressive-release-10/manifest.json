    {
      "index": 19,
      "text": "让小腿变得沉重。",
      "file": "c019.ogg",
      "durationSec": 3.96
    },
    {
      "index": 20,
      "text": "[暂停：21]",
      "file": "c020.ogg",
      "durationSec": 4.488
    },
    {
      "index": 21,
      "text": "收紧大腿。",
