  "chunks": [
    {
      "index": 0,
      "text": "欢迎。",
      "file": "c000.ogg",
      "durationSec": 2.688
    },
    {
      "index": 1,
      "text": "需要时间到达。",
      "file": "c001.ogg",
      "durationSec": 3.72
    },
    {
      "index": 2,
      "text": "在支撑下坐下或躺下。",
      "file": "c002.ogg",
      "durationSec": 4.968
    },
    {
      "index": 3,
      "text": "如果感觉安全，请闭上眼睛。",
      "file": "c003.ogg",
      "durationSec": 5.904
    },
    {
      "index": 4,
      "text": "感受与地面的接触。",
      "file": "c004.ogg",
      "durationSec": 4.08
    },
    {
      "index": 5,
      "text": "缓慢吸气。",
      "file": "c005.ogg",
      "durationSec": 3.312
    },
    {
      "index": 6,
      "text": "呼气时间更长。",
      "file": "c006.ogg",
      "durationSec": 4.056
    },
    {
      "index": 7,
      "text": "[暂停：28]",
      "file": "c007.ogg",
      "durationSec": 4.536
    },
    {
      "index": 8,
      "text": "再次。",
      "file": "c008.ogg",
      "durationSec": 2.664
    },
    {
      "index": 9,
      "text": "[暂停：28]",
      "file": "c009.ogg",
      "durationSec": 4.536
    },
    {
      "index": 10,
      "text": "让肩膀下垂。",
      "file": "c010.ogg",
      "durationSec": 3.6
    },
    {
      "index": 11,
      "text": "让腹部变软。",
      "file": "c011.ogg",
      "durationSec": 3.504
    },
    {
      "index": 12,
      "text": "[暂停：36]",
      "file": "c012.ogg",
      "durationSec": 4.632
    },
    {
      "index": 13,
      "text": "把自己想象成一座山。",
      "file": "c013.ogg",
      "durationSec": 4.272
    },
    {
      "index": 14,
      "text": "底座宽。山顶安静。极大的耐心。",
      "file": "c014.ogg",
      "durationSec": 8.304
    },
    {
      "index": 15,
      "text": "[暂停：43]",
      "file": "c015.ogg",
      "durationSec": 4.584
    },
    {
      "index": 16,
      "text": "天气在山上移动。",
      "file": "c016.ogg",
      "durationSec": 4.152
    },
    {
      "index": 17,
      "text": "太阳。风。云。风暴。",
      "file": "c017.ogg",
      "durationSec": 8.544
    },
    {
      "index": 18,
      "text": "山仍存。",
      "file": "c018.ogg",
      "durationSec": 3.336
    },
    {
      "index": 19,
      "text": "[暂停：57]",
      "file": "c019.ogg",
      "durationSec": 4.344
    },
    {
      "index": 20,
      "text": "思想和情绪就是天气。",
      "file": "c020.ogg",
      "durationSec": 5.208
    },
    {
      "index": 21,
      "text": "你就是那座山。",
      "file": "c021.ogg",
      "durationSec": 3.6
    },
    {
      "index": 22,
      "text": "[暂停：57]",
      "file": "c022.ogg",
      "durationSec": 4.344
    },
    {
      "index": 23,
      "text": "感觉身体的根部扎根。",
      "file": "c023.ogg",
      "durationSec": 4.44
    },
    {
      "index": 24,
      "text": "感受脊柱的高度，不产生任何压力。",
      "file": "c024.ogg",
      "durationSec": 6.528
    },
    {
      "index": 25,
      "text": "[暂停：43]",
      "file": "c025.ogg",
      "durationSec": 4.584
    },
    {
      "index": 26,
      "text": "呼吸如山周围的天空。",
      "file": "c026.ogg",
      "durationSec": 4.584
    },
    {
      "index": 27,
      "text": "[暂停：71]",
      "file": "c027.ogg",
      "durationSec": 4.368
    },
    {
      "index": 28,
      "text": "稳定的。不紧不慢。足够的。",
      "file": "c028.ogg",
      "durationSec": 7.464
    },
    {
      "index": 29,
      "text": "[暂停：90]",
      "file": "c029.ogg",
      "durationSec": 4.032
    },
    {
      "index": 30,
      "text": "[暂停：43]",
      "file": "c030.ogg",
      "durationSec": 4.584
    },
    {
      "index": 31,
      "text": "开始加深呼吸。",
      "file": "c031.ogg",
      "durationSec": 3.792
    },
    {
      "index": 32,
      "text": "再次感受一下房间。",
      "file": "c032.ogg",
      "durationSec": 4.08
    },
    {
      "index": 33,
      "text": "摆动手指和脚趾。",
      "file": "c033.ogg",
      "durationSec": 4.32
    },
    {
      "index": 34,
      "text": "准备好后，睁开眼睛。",
      "file": "c034.ogg",
      "durationSec": 4.728
    },
    {
      "index": 35,
      "text": "慢慢地进入接下来的事情。",
      "file": "c035.ogg",
      "durationSec": 4.512
    }
  ]
}
