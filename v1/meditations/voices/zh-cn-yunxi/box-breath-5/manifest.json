  "chunks": [
    {
      "index": 0,
      "text": "欢迎。",
      "file": "c000.ogg",
      "durationSec": 2.688
    },
    {
      "index": 1,
      "text": "找一个舒适的座位，或者如果感觉好一点的话就躺下来。",
      "file": "c001.ogg",
      "durationSec": 8.736
    },
    {
      "index": 2,
      "text": "让双手休息一下。",
      "file": "c002.ogg",
      "durationSec": 3.864
    },
    {
      "index": 3,
      "text": "软化眼睛，或闭上眼睛。",
      "file": "c003.ogg",
      "durationSec": 5.4
    },
    {
      "index": 4,
      "text": "缓慢吸气。",
      "file": "c004.ogg",
      "durationSec": 3.312
    },
    {
      "index": 5,
      "text": "并且呼气时间更长。",
      "file": "c005.ogg",
      "durationSec": 5.304
    },
    {
      "index": 6,
      "text": "我们将在一个简单的盒子里呼吸。",
      "file": "c006.ogg",
      "durationSec": 5.088
    },
    {
      "index": 7,
      "text": "四人入。坚持四个。四人出局。坚持四个。",
      "file": "c007.ogg",
      "durationSec": 10.896
    },
    {
      "index": 8,
      "text": "保持温柔。切勿紧张。",
      "file": "c008.ogg",
      "durationSec": 5.784
    },
    {
      "index": 9,
      "text": "[暂停：20]",
      "file": "c009.ogg",
      "durationSec": 4.56
    },
    {
      "index": 10,
      "text": "吸入。二。三。四。",
      "file": "c010.ogg",
      "durationSec": 8.568
    },
    {
      "index": 11,
      "text": "抓住。二。三。四。",
      "file": "c011.ogg",
      "durationSec": 8.448
    },
    {
      "index": 12,
      "text": "呼气。二。三。四。",
      "file": "c012.ogg",
      "durationSec": 8.712
    },
    {
      "index": 13,
      "text": "抓住。二。三。四。",
      "file": "c013.ogg",
      "durationSec": 8.448
    },
    {
      "index": 14,
      "text": "[暂停：20]",
      "file": "c014.ogg",
      "durationSec": 4.56
    },
    {
      "index": 15,
      "text": "再次。吸入。",
      "file": "c015.ogg",
      "durationSec": 4.752
    },
    {
      "index": 16,
      "text": "抓住。",
      "file": "c016.ogg",
      "durationSec": 2.616
    },
    {
      "index": 17,
      "text": "呼气。",
      "file": "c017.ogg",
      "durationSec": 2.88
    },
    {
      "index": 18,
      "text": "抓住。",
      "file": "c018.ogg",
      "durationSec": 2.616
    },
    {
      "index": 19,
      "text": "[暂停：26]",
      "file": "c019.ogg",
      "durationSec": 4.728
    },
    {
      "index": 20,
      "text": "继续自己数数几轮。",
      "file": "c020.ogg",
      "durationSec": 4.056
    },
    {
      "index": 21,
      "text": "如果四个太长，请使用三个。",
      "file": "c021.ogg",
      "durationSec": 5.496
    },
    {
      "index": 22,
      "text": "[暂停：45]",
      "file": "c022.ogg",
      "durationSec": 4.56
    },
    {
      "index": 23,
      "text": "再来一盒满满的。",
      "file": "c023.ogg",
      "durationSec": 3.744
    },
    {
      "index": 24,
      "text": "吸入。",
      "file": "c024.ogg",
      "durationSec": 2.736
    },
    {
      "index": 25,
      "text": "抓住。",
      "file": "c025.ogg",
      "durationSec": 2.616
    },
    {
      "index": 26,
      "text": "呼气。",
      "file": "c026.ogg",
      "durationSec": 2.88
    },
    {
      "index": 27,
      "text": "抓住。",
      "file": "c027.ogg",
      "durationSec": 2.616
    },
    {
      "index": 28,
      "text": "[暂停：26]",
      "file": "c028.ogg",
      "durationSec": 4.728
    },
    {
      "index": 29,
      "text": "回归自然呼吸。",
      "file": "c029.ogg",
      "durationSec": 3.768
    },
    {
      "index": 30,
      "text": "注意接下来的安静。",
      "file": "c030.ogg",
      "durationSec": 3.768
    },
    {
      "index": 31,
      "text": "[暂停：33]",
      "file": "c031.ogg",
      "durationSec": 4.608
    },
    {
      "index": 32,
      "text": "在这里休息。",
      "file": "c032.ogg",
      "durationSec": 3.12
    },
    {
      "index": 33,
      "text": "[暂停：33]",
      "file": "c033.ogg",
      "durationSec": 4.608
    },
    {
      "index": 34,
      "text": "再轻松地吸一口气。",
      "file": "c034.ogg",
      "durationSec": 4.08
    },
    {
      "index": 35,
      "text": "动动手指。",
      "file": "c035.ogg",
      "durationSec": 3.264
    },
    {
      "index": 36,
      "text": "准备好后，睁开眼睛。",
      "file": "c036.ogg",
      "durationSec": 4.728
    },
    {
      "index": 37,
      "text": "随身携带一点这个。",
      "file": "c037.ogg",
      "durationSec": 4.008
    }
  ]
