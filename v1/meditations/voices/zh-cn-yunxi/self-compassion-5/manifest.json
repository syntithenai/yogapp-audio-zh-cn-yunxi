{
  "id": "self-compassion-5",
  "voiceId": "zh-cn-yunxi",
  "edgeVoice": "zh-CN-YunxiNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 136,
  "chunks": [
    {
      "index": 0,
      "text": "欢迎。",
      "file": "c000.ogg",
      "durationSec": 2.688
    },
    {
      "index": 1,
      "text": "找一个舒适的座位，或者如果感觉好一点的话就躺下来。",
      "file": "c001.ogg",
      "durationSec": 8.736
    },
    {
      "index": 2,
      "text": "让双手休息一下。",
      "file": "c002.ogg",
      "durationSec": 3.864
    },
    {
      "index": 3,
      "text": "软化眼睛，或闭上眼睛。",
      "file": "c003.ogg",
      "durationSec": 5.4
    },
    {
      "index": 4,
      "text": "缓慢吸气。",
      "file": "c004.ogg",
      "durationSec": 3.312
    },
    {
      "index": 5,
      "text": "并且呼气时间更长。",
      "file": "c005.ogg",
      "durationSec": 5.304
    },
    {
      "index": 6,
      "text": "将手放在心脏上，或将双手放在膝盖上。",
      "file": "c006.ogg",
      "durationSec": 7.584
    },
    {
      "index": 7,
      "text": "注意你现在的样子，但不要去修正它。",
      "file": "c007.ogg",
      "durationSec": 6.288
    },
    {
      "index": 8,
      "text": "[暂停：31]",
      "file": "c008.ogg",
      "durationSec": 4.56
    },
    {
      "index": 9,
      "text": "如果有挣扎，承认它。",
      "file": "c009.ogg",
      "durationSec": 5.088
    },
    {
      "index": 10,
      "text": "这是一个困难的时刻。",
      "file": "c010.ogg",
      "durationSec": 3.984
    },
    {
      "index": 11,
      "text": "困难是人类的一部分。",
      "file": "c011.ogg",
      "durationSec": 4.224
    },
    {
      "index": 12,
      "text": "[暂停：39]",
      "file": "c012.ogg",
      "durationSec": 4.656
    },
    {
      "index": 13,
      "text": "像对待朋友一样善待自己。",
      "file": "c013.ogg",
      "durationSec": 5.472
    },
    {
      "index": 14,
      "text": "愿我善待自己。",
      "file": "c014.ogg",
      "durationSec": 3.912
    },
    {
      "index": 15,
      "text": "愿我给予自己我所需要的同情心。",
      "file": "c015.ogg",
      "durationSec": 6.288
    },
    {
      "index": 16,
      "text": "[暂停：39]",
      "file": "c016.ogg",
      "durationSec": 4.656
    },
    {
      "index": 17,
      "text": "再次，慢慢地。",
      "file": "c017.ogg",
      "durationSec": 4.272
    },
    {
      "index": 18,
      "text": "愿我善待自己。",
      "file": "c018.ogg",
      "durationSec": 3.912
    },
    {
      "index": 19,
      "text": "愿我给予自己我所需要的同情心。",
      "file": "c019.ogg",
      "durationSec": 6.288
    },
    {
      "index": 20,
      "text": "[暂停：45]",
      "file": "c020.ogg",
      "durationSec": 4.56
    },
    {
      "index": 21,
      "text": "呼吸到放在心脏上的手（如果有的话）。",
      "file": "c021.ogg",
      "durationSec": 6.576
    },
    {
      "index": 22,
      "text": "[暂停：39]",
      "file": "c022.ogg",
      "durationSec": 4.656
    },
    {
      "index": 23,
      "text": "你不必赢得这种柔软。",
      "file": "c023.ogg",
      "durationSec": 4.08
    },
    {
      "index": 24,
      "text": "再轻松地吸一口气。",
      "file": "c024.ogg",
      "durationSec": 4.08
    },
    {
      "index": 25,
      "text": "动动手指。",
      "file": "c025.ogg",
      "durationSec": 3.264
    },
    {
      "index": 26,
      "text": "准备好后，睁开眼睛。",
      "file": "c026.ogg",
      "durationSec": 4.728
    },
    {
      "index": 27,
      "text": "随身携带一点这个。",
      "file": "c027.ogg",
      "durationSec": 4.008
    }
  ]
}
